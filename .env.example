# ==============================================================================
# Graph Database Benchmarking Environment Configuration (.env.example)
# Copy this file to .env and provide your instance endpoints and credentials.
# NEVER COMMIT THE ACTUAL .env FILE CONTAINING PASSWORDS OR SECRETS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. COGNODB CLOUD (Primary Subject under test)
# Signup / Console: https://console.cognodb.com/signup
# Free instance: c0 (~0.5 vCPU, 256MB RAM, 1GB disk)
# Uses standard Neo4j official Bolt driver and Cypher
# ------------------------------------------------------------------------------
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=your_cognodb_password_here
COGNODB_DATABASE=cognodb

# ------------------------------------------------------------------------------
# 2. NEO4J AURADB FREE or NEO4J COMMUNITY
# Console: https://console.neo4j.io
# Free instance: AuraDB Free (200k nodes / 400k relationships limit)
# Or Local Docker: bolt://localhost:7687
# ------------------------------------------------------------------------------
NEO4J_URI=neo4j+s://<your-dbid>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# 3. MEMGRAPH CLOUD or MEMGRAPH COMMUNITY (DOCKER)
# Cloud: https://cloud.memgraph.com
# Local Docker: bolt://localhost:7688
# ------------------------------------------------------------------------------
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=
MEMGRAPH_DATABASE=memgraph

# ------------------------------------------------------------------------------
# 4. FALKORDB CLOUD or FALKORDB COMMUNITY (DOCKER)
# Cloud: https://app.falkordb.cloud
# Local Docker: localhost:6379
# ------------------------------------------------------------------------------
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=github_benchmark

# ------------------------------------------------------------------------------
# 5. ARANGODB OASIS (ARANGOGRAPH) or ARANGODB COMMUNITY (DOCKER)
# Cloud: https://cloud.arangodb.com
# Local Docker: http://localhost:8529
# ------------------------------------------------------------------------------
ARANGODB_URL=http://localhost:8529
ARANGODB_USER=root
ARANGODB_PASSWORD=your_arango_password_here
ARANGODB_DATABASE=github_benchmark

# ------------------------------------------------------------------------------
# 6. KUZU (Embedded Columnar Baseline - Zero Cloud Config Required)
# Automatically creates database in data/kuzu_db/
# ------------------------------------------------------------------------------
KUZU_DATABASE_PATH=data/kuzu_db
